#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1.0
    upAxis = "Z"
)

def Xform "World"
{
    def Camera "MainCam"
    {
        float2 clippingRange = (0.1, 10000)
        float focalLength = 35.0
        float focusDistance = 5.0
        float horizontalAperture = 36.0
        float verticalAperture = 24.0
        double3 xformOp:translate = (0.0, -4.0, 1.5)
        double3 xformOp:rotateXYZ = (80.0, 0.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def "KeyLight" (
        prepend apiSchemas = ["DistantLightAPI"]
    )
    {
        float inputs:intensity = 5.0
        color3f inputs:color = (1.0, 0.9, 0.7)
        token inputs:lightType = "distant"
    }

}
